{
  "name": "infinite-reader-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "npm --prefix ../web run build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply infinite-reader --local",
    "db:migrate:remote": "wrangler d1 migrations apply infinite-reader --remote"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "agents": "0.30.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.150.0"
  }
}
