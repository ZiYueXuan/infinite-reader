{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinite-reader",

  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "READER_AGENT", "class_name": "ReaderAgent" }] },
  "migrations": [{ "tag": "v1-reader-agent", "new_sqlite_classes": ["ReaderAgent"] }],
  "workers_dev": true,

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    // Public entry HTML is prerendered; reader routes explicitly serve the app shell.
    "run_worker_first": ["/", "/index.html", "/shelf", "/shelf/", "/book/*", "/_landing/*", "/api/*", "/about", "/privacy", "/terms", "/about/", "/privacy/", "/terms/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infinite-reader",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BOOKS", "bucket_name": "reader-books" }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "reader-chunks" }],
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "reader-index" }],
    "consumers": [
      {
        "queue": "reader-index",
        "max_batch_size": 1,
        "max_retries": 5,
        "dead_letter_queue": "reader-index-dlq"
      }
    ]
  },
  "vars": {
    "APP_NAME": "Infinite Reader",
    // Disabled to prevent full-book extraction costs; saved results remain intact.
    "BOOKLIST_ENABLED": "false",
    "CONTACT_EMAIL": "support@example.test",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-chat",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "MAX_UPLOAD_MB": "50",
    "EMAIL_PROVIDER": "none",
    "EMAIL_FROM": "Infinite Reader <login@example.test>",
    "ALLOWED_EMAILS": "",
    "PUBLIC_BASE_URL": "",
    "SESSION_TTL_DAYS": "30",
    "ALLOWED_ORIGINS": "",
    "DEEPSEEK_ALLOWED_MODELS": "deepseek-chat,deepseek-reasoner"
  }
}
